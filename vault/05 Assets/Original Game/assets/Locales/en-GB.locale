TUT_CHALLENGE_TITLE = "CHALLENGE CHAINS"
TUT_CHALLENGE_BODY = "CLIMB ABOARD THE CHALLENGE CHOPPER AND TEST YOUR SKILLS IN A SPECIAL MISSION WITH A DIFFERENT AGENT.\n\n - COMPLETE THE CURRENT MISSION TO UNLOCK THE NEXT.\n - COMPLETE A CHAIN TO CLAIM THE TOP PRIZE\n - AND GET A SPECIAL OFFER ON THE AGENT'S SALE PRICE!"

TUT_SHOP_TITLE = "THE VAULT"
TUT_SHOP_BODY = "AGENCY RESOURCES ARE WELL PROTECTED SO YOU CAN;\n\n - REPLENISH YOUR GEM SUPPLY\n - REPLENISH YOUR COIN SUPPLY\n - GET FREE GOODIES IN THE OFFERS TAB"

TUT_BARRACKS_TITLE = "THE BARRACKS"
TUT_BARRACKS_BODY = "HOME SWEET HOME. I LOVE THE MUSKY SMELL IN HERE.\n\nNOW LISTEN. THE FLASHING BLUE CIRCLE UNDERNEATH AN AGENT MEANS THERE ARE UPGRADES AVAILABLE.\n\nCENTER THE AGENT AND PURCHASE THE UPGRADE FOR THE WEAPON OR GADGET.\n\n HERE ARE %s COINS FOR YOUR FIRST UPGRADE!"

TUT_BARRACKS_REMINDER_TITLE = "GET A SECOND CHARACTER"
TUT_BARRACKS_REMINDER_BODY = "NOT SO FAST!\n\nYOU NEED TO BUY AND EQUIP A SECOND AGENT BEFORE LEAVING THE BARRACKS.\n\nI'VE GIVEN YOU ENOUGH FREE GEMS TO BUY ONE OF THE AGENTS ALREADY, SO GET BUSY AND SET IT TO YOUR SECOND SLOT."

TUT_UPGRADES_TITLE = "UPGRADE AVAILABLE"
TUT_UPGRADES_BODY = "THE FLASHING BLUE CIRCLE UNDERNEATH AN AGENT MEANS THERE ARE UPGRADES AVAILABLE FOR THAT AGENT.\n\nCENTER THE AGENT AND PURCHASE YOUR UPGRADE!"

TUT_HEAL_TITLE = "THE HEALING STATION"
